<Window x:Class="Loader.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Settings" Width="350" Height="530"
        Icon="pack://application:,,,/Assets/app_icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Стиль кнопок темы -->
        <Style x:Key="ThemeButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8E9EAF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                CornerRadius="6" Padding="10,7"
                                Background="#08111D"
                                BorderBrush="#182A3D"
                                BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4A6A8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль слайдера (синий ползунок, тёмная дорожка) -->
        <Style x:Key="CustomSlider" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- Дорожка (тёмная) -->
                            <Border Height="4" CornerRadius="2" Background="#141B24"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#3FA1FF"
                                                         Stroke="#1A3050" StrokeThickness="1.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#3FA1FF" BlurRadius="6"
                                                                          ShadowDepth="0" Opacity="0.35"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="10" Background="#0C1724" BorderBrush="#1B2D42" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.92" ScaleY="0.92"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="#01FFFFFF"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Hand">
                <TextBlock Text="个人资料设置" Foreground="White"
                           FontSize="11.5" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           IsHitTestVisible="False"/>
                <Button Content="✕" Style="{StaticResource TitleButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,10,0" Click="Close_Click"/>
            </Grid>

            <!-- Разделитель -->
            <Rectangle Grid.Row="1" Fill="#1B2D42"/>

            <!-- Содержимое -->
            <StackPanel Grid.Row="2" Margin="16,14,16,12">

                <!-- Карточка профиля -->
                <Border CornerRadius="8" Background="#08111D" BorderBrush="#14263A" BorderThickness="1"
                        Padding="12,10" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="38" Height="38">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <BitmapImage UriSource="pack://application:,,,/Assets/avatar.png" DecodePixelWidth="152"/>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="ProfileNick" Text="LKY0112" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Premium · Active" Foreground="#3FA1FF" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Тема -->
                <TextBlock Text="界面主题" Foreground="#8E9EAF" FontSize="10.5" FontWeight="SemiBold"
                           Margin="2,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnRainTheme" Grid.Column="0"
                            Content="🌧  雨滴玻璃" Style="{StaticResource ThemeButton}"
                            Click="RainTheme_Click"/>
                    <Button x:Name="BtnClassicTheme" Grid.Column="2"
                            Content="🌑  经典" Style="{StaticResource ThemeButton}"
                            Click="ClassicTheme_Click"/>
                </Grid>

                <!-- Слайдер прозрачности фона -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="背景透明度" Foreground="#8E9EAF" FontSize="10.5" FontWeight="SemiBold"
                               Margin="2,0,0,0"/>
                    <TextBlock x:Name="TxtBgOpacity" Grid.Column="1" Text="84%" Foreground="#3FA1FF"
                               FontSize="10.5" FontWeight="Bold" Margin="0,0,2,0"/>
                </Grid>
                <Slider x:Name="SliderBg" Style="{StaticResource CustomSlider}"
                        Minimum="20" Maximum="100" Value="98"
                        ValueChanged="SliderBg_ValueChanged" Margin="0,0,0,10"/>

                <!-- 挂件透明度 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="挂件透明度" Foreground="#8E9EAF" FontSize="10.5" FontWeight="SemiBold"
                               Margin="2,0,0,0"/>
                    <TextBlock x:Name="TxtHippoOpacity" Grid.Column="1" Text="96%" Foreground="#3FA1FF"
                               FontSize="10.5" FontWeight="Bold" Margin="0,0,2,0"/>
                </Grid>
                <Slider x:Name="SliderHippo" Style="{StaticResource CustomSlider}"
                        Minimum="0" Maximum="100" Value="96"
                        ValueChanged="SliderHippo_ValueChanged" Margin="0,0,0,10"/>

                <!-- 卡片背景透明度 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="卡片背景透明度" Foreground="#8E9EAF" FontSize="10.5" FontWeight="SemiBold"
                               Margin="2,0,0,0"/>
                    <TextBlock x:Name="TxtCardsOpacity" Grid.Column="1" Text="100%" Foreground="#3FA1FF"
                               FontSize="10.5" FontWeight="Bold" Margin="0,0,2,0"/>
                </Grid>
                <Slider x:Name="SliderCards" Style="{StaticResource CustomSlider}"
                        Minimum="0" Maximum="100" Value="100"
                        ValueChanged="SliderCards_ValueChanged" Margin="0,0,0,14"/>

                <!-- 背景图 -->
                <TextBlock Text="背景图" Foreground="#8E9EAF" FontSize="10.5" FontWeight="SemiBold"
                           Margin="2,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnBgPick" Content="🖼  选择背景图" Style="{StaticResource ThemeButton}"
                            Click="PickBg_Click"/>
                    <Button x:Name="BtnBgReset" Grid.Column="2" Content="↺  默认背景" Style="{StaticResource ThemeButton}"
                            Click="ResetBg_Click"/>
                </Grid>

                <!-- 头像与昵称 -->
                <TextBlock Text="头像" Foreground="#8E9EAF" FontSize="10.5" FontWeight="SemiBold"
                           Margin="2,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnAvatarPick" Content="👤  更换头像" Style="{StaticResource ThemeButton}"
                            Click="PickAvatar_Click"/>
                    <Button x:Name="BtnAvatarReset" Grid.Column="2" Content="↺  恢复默认" Style="{StaticResource ThemeButton}"
                            Click="ResetAvatar_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>

