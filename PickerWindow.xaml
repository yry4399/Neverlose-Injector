<Window x:Class="Loader.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose" Width="392" Height="318"
        Icon="pack://application:,,,/Assets/app_icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7C8C9E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="4" Padding="7,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#2A4058" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Width" Value="7"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="10" Background="#0C1724" BorderBrush="#1B2D42" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.92" ScaleY="0.92"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock x:Name="TitleText" Foreground="White"
                           FontSize="11.5" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                <Button Content="✕" Style="{StaticResource TitleButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,10,0" Click="Close_Click"/>
            </Grid>

            <Rectangle Grid.Row="1" Fill="#1B2D42"/>

            <ScrollViewer Grid.Row="2" x:Name="ListScroll"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="8,6,4,4">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource PickerScrollBar}"/>
                </ScrollViewer.Resources>
                <WrapPanel x:Name="CardsPanel" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="点击图片即可选择"
                       Foreground="#627891" FontSize="9.5"
                       HorizontalAlignment="Center" Margin="0,2,0,8"/>
        </Grid>
    </Border>
</Window>
