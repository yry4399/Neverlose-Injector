<Window x:Class="Loader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NL Loader" Width="477" Height="336"
        Icon="pack://application:,,,/Assets/app_icon.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">
    <Grid>
        <!-- Карточка лоадера: сначала splash 120x120, затем раскрывается в 477x336 -->
        <Border x:Name="Card"
                Width="120" Height="120" CornerRadius="16" BorderThickness="1"
                Background="#D607101C"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5" Opacity="0"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                    <GradientStop Color="#5575AEE5" Offset="0"/>
                    <GradientStop Color="#182A40" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0" ScaleY="0.7"/>
            </Border.RenderTransform>

            <Grid ClipToBounds="True">
                <Grid.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="{Binding ActualWidth, ElementName=Card}"
                                    Height="{Binding ActualHeight, ElementName=Card}"
                                    CornerRadius="16" Background="Black"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>

                
                <!-- Заблюренное стекло: мягкий световой блик -->
                <Border x:Name="GlassSheen" CornerRadius="16" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#04FFFFFF" Offset="0.3"/>
                            <GradientStop Color="#00000000" Offset="0.65"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Эффект мокрого стекла: капельки дождя -->
                <Image x:Name="RaindropsLayer" Source="pack://application:,,,/Assets/raindrops.png"
                       Stretch="Fill"
                       Opacity="0.82"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
<!-- 1. Крутящийся кружок YouTube-буферизации (без надписи) -->
                <Canvas x:Name="SpinnerLayer" Width="56" Height="56"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="SpinnerScale" ScaleX="1" ScaleY="1"/>
                    </Canvas.RenderTransform>
                    <Canvas x:Name="SpinnerCanvas" Width="56" Height="56" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Canvas>

                <!-- 2. Затемнение и размытие фона во время инжекта -->
                <Border x:Name="Backdrop" CornerRadius="15" Background="#03070D" Opacity="0" IsHitTestVisible="False"/>

                <Grid x:Name="BackdropContent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="BackdropScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid.Effect>
                        <BlurEffect x:Name="BackdropBlur" Radius="0"/>
                    </Grid.Effect>

                    <!-- Основное меню лоадера -->
                    <Grid x:Name="MainContent" Margin="18,16,16,16" Opacity="0" Visibility="Collapsed"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ContentScale" ScaleX="0.96" ScaleY="0.96"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="124"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="NlTitle" Text="NL" FontSize="28" FontWeight="Black" Foreground="White" Margin="3,0,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#19C3FF" Direction="180" ShadowDepth="1.5" BlurRadius="0" Opacity="1"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <StackPanel x:Name="NavPanel" Grid.Row="1" Margin="2,34,0,0">
                                <Button Content="Website" Style="{StaticResource NavButton}" Click="Website_Click"/>
                                <Button Content="Support" Style="{StaticResource NavButton}" Click="Support_Click"/>
                                <Button Content="Market" Style="{StaticResource NavButton}" Click="Market_Click"/>
                                <Button Content="About" Style="{StaticResource NavButton}" Click="About_Click"/>
                            </StackPanel>

                            <!-- Аватарка и ник cracker -->
                            <Border Grid.Row="2" x:Name="ProfileButton" Cursor="Hand" ToolTip="个人资料与主题设置（点击）"
                                    Background="Transparent" MouseLeftButtonDown="Profile_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.9"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="pack://application:,,,/Assets/avatar.png" DecodePixelWidth="136"/>
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock x:Name="NickText" Text="LKY0112" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Правая колонка -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,1,0,0">
                                <TextBlock x:Name="SubscriptionTitle" Text="Subscription" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SubLabel" Text="Available subscriptions" Foreground="#7C8C9E" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-4,0">
                                <Button Content="—" Style="{StaticResource TitleButton}" Click="Minimize_Click"/>
                                <Button Content="✕" Style="{StaticResource TitleButton}" Click="Close_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="GameCardsStack" Grid.Row="1" Margin="0,12,0,0">
                                <!-- CS:GO карточка -->
                                <Border x:Name="CsgoCard" Height="46" CornerRadius="7" Background="#08111D"
                                        BorderThickness="1" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                                        Tag="csgo" Margin="0,0,0,8"
                                        MouseEnter="GameCard_MouseEnter" MouseLeave="GameCard_MouseLeave"
                                        MouseLeftButtonDown="GameCard_MouseLeftButtonDown"
                                        MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#0F2236"/>
                                    </Border.BorderBrush>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Border x:Name="CsgoCardGlow" CornerRadius="6" Background="White" Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Grid Margin="11,7">
                                            <StackPanel>
                                                <TextBlock x:Name="CsgoTitle" Text="Counter-Strike: Global Offensive" FontSize="11.5"
                                                           Foreground="White" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="CsgoExpires" Text="Expires: never" FontSize="10" Foreground="#7C8C9E" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Width="22" Height="22" CornerRadius="4" ClipToBounds="True"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#0A1622">
                                                <Image Source="pack://application:,,,/Assets/csgo.png" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4A6A8C"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- CS2 карточка -->
                                <Border x:Name="Cs2Card" Height="46" CornerRadius="7" Background="#08111D"
                                        BorderThickness="1" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                                        Tag="cs2"
                                        MouseEnter="GameCard_MouseEnter" MouseLeave="GameCard_MouseLeave"
                                        MouseLeftButtonDown="GameCard_MouseLeftButtonDown"
                                        MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#0F2236"/>
                                    </Border.BorderBrush>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Border x:Name="Cs2CardGlow" CornerRadius="6" Background="White" Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <Grid Margin="11,7">
                                            <StackPanel>
                                                <TextBlock x:Name="Cs2Title" Text="Counter-Strike 2" FontSize="11.5"
                                                           Foreground="White" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="Cs2Expires" Text="Expires: never" FontSize="10" Foreground="#7C8C9E" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Width="22" Height="22" CornerRadius="4" ClipToBounds="True"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#0A1622">
                                                <Image Source="pack://application:,,,/Assets/cs2.png" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4A6A8C"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>

                            <!-- 小河马与右下角时间 -->
                            <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,4,4">
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <Border x:Name="HippoBorder" Cursor="Hand" ToolTip="更换小河马（点击）"
                                            Background="Transparent" MouseLeftButtonDown="Hippo_Click"
                                            HorizontalAlignment="Right">
                                        <Image x:Name="HippoImage" Width="92" Height="95"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Stretch="Uniform" HorizontalAlignment="Right"/>
                                    </Border>
                                    <TextBlock x:Name="ClockText" IsHitTestVisible="False" Text="--:--" Foreground="#7C8C9E" FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Margin="0,2,2,0"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 3. Панель загрузки / инжекта (меньше окна на 200: 277x136) -->
                <Border x:Name="InjectPanel" Width="277" Height="136"
                        CornerRadius="10" Background="#060C14" BorderBrush="#141C26" BorderThickness="1"
                        Opacity="0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="InjectScale" ScaleX="0.94" ScaleY="0.94"/>
                    </Border.RenderTransform>
                    <Grid x:Name="InjectGrid" Margin="16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock x:Name="InjectTitle" Text="Injecting" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="InjectPercent" Text="0%" Foreground="#4F7FB5" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Ползунок загрузки: серый фон, сплошной синий цвет, текст сверху следует за ним -->
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="6"/>
                            </Grid.RowDefinitions>

                            <Canvas Grid.Row="0" x:Name="LabelLayer" ClipToBounds="False">
                                <StackPanel x:Name="StageLabel" Orientation="Horizontal" Canvas.Left="0" Canvas.Top="0">
                                    <TextBlock x:Name="StageText" Text="Loading game" Foreground="#E6EEF7" FontSize="10"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Canvas>

                            <!-- Серый незаполненный фон ползунка -->
                            <Border Grid.Row="1" x:Name="ProgressBackground" CornerRadius="3" Background="#141B24" Height="6"/>
                            <!-- Сплошной синий заполняющийся ползунок (без градиента) -->
                            <Border Grid.Row="1" x:Name="ProgressTrack" CornerRadius="3" Height="6" Width="0"
                                    HorizontalAlignment="Left" Background="#2478D0"/>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="InjectHint"
                                   Text="Preparing game process" Margin="0,6,0,0"
                                   Foreground="#6E8199" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
